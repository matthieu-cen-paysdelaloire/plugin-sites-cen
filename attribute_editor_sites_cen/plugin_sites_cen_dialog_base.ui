<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <!-- ==========================================================================
       GESTIONNAIRE DES SITES CEN : interface du formulaire (Qt Designer / PyQt)

       Classe : AttributeEditorSitesCENDialogBase (QDialog). Chargé par
       plugin_sites_cen_dialog.py (uic.loadUiType) ; la logique est dans les
       fichiers dialog_*_mixin.py.

       PLAN DU FICHIER
         0. Propriétés de la fenêtre et mise en page principale
         1. Bandeau d'information en haut
         2. Zone principale (splitter redimensionnable) en 2 colonnes :
              2A. Colonne gauche : recherche, liste sites/parcelles, carte
              2B. Colonne droite : bouton mode édition + pile de formulaires (formStack)
                    page 0 = fiche du site (4 onglets)
                    page 1 = fiche de la parcelle (11 groupes)
                    page 2 = bilan foncier (ajoutée par le code Python, absente d'ici)
         3. Barre de boutons du bas (Annuler / Appliquer / OK)

       CONVENTIONS
         - lbl_<widget> : libellé d'un champ. Il se termine par un ❓ dont l'infobulle
           est définie dans dialog_data.py (dictionnaire HELP_TEXTS).
         - Widget de saisie associé : txt... / cb... / spin... / date... Les champs
           des sites sont nommés txtSite_<champ>, ceux des parcelles txtParc_<champ>.
         - ✏️ devant un libellé = champ modifiable. Pour les sites, les champs sans ✏️
           sont en lecture seule et sont masqués lorsque le mode édition est actif
           (voir toggle_simple_view dans dialog_ui_mixin.py).

       ATTENTION : ces commentaires sont supprimés si le fichier est ré-enregistré
       depuis Qt Designer.
       ========================================================================== -->
  <class>AttributeEditorSitesCENDialogBase</class>
  
  <widget class="QDialog" name="AttributeEditorSitesCENDialogBase">
    <!-- Fenêtre : taille initiale 950 x 750 px, puis titre « Gestionnaire des sites CEN ». -->
    <property name="geometry">
      <rect>
        <x>0</x>
        <y>0</y>
        <width>950</width>
        <height>750</height>
      </rect>
    </property>
    
    <property name="windowTitle">
      <string>Gestionnaire des sites CEN</string>
    </property>
    
    <!-- Feuille de style globale (QSS), héritée par tous les widgets de la fenêtre :
         libellés et titres de groupes en gras (#2c3e50), infobulles jaunes, champs de
         saisie à bordure grise arrondie, cadres de groupes arrondis, boutons gris clair,
         poignée du splitter grise (bleue au survol), listes déroulantes à fond blanc.
         Certains widgets redéfinissent localement leur propre style (ex. labelHeaderInfo). -->
    <property name="styleSheet">
      <string>
        QLabel, QGroupBox { font-weight: bold; color: #2c3e50; }
        QToolTip { font-weight: normal; background-color: #ffe089; border: 1px solid #bdc3c7; color: #2c3e50; padding: 2px; }
        QComboBox, QSpinBox, QLineEdit, QTextEdit, QDateEdit { border: 1px solid #bdc3c7; border-radius: 4px; padding: 3px 5px; background-color: white; font-weight: normal; }
        QGroupBox { border: 1px solid #bdc3c7; border-radius: 6px; margin-top: 15px; } 
        QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
        QPushButton { border: 1px solid #bdc3c7; border-radius: 4px; background-color: #f8f9fa; padding: 5px; }
        QFrame#rowBlock { border: none; background-color: transparent; padding-bottom: 15px; }
        QSplitter::handle { background-color: #dcdde1; border-left: 1px solid #bdc3c7; border-right: 1px solid #bdc3c7; }
        QSplitter::handle:horizontal { width: 10px; }
        QSplitter::handle:hover { background-color: #3498db; }
        QComboBox QAbstractItemView {
          background-color: white;
          color: #2c3e50;
          selection-background-color: white;
          selection-color: #3498db;
          outline: 0;
        }
      </string>
    </property>

    <!-- Mise en page principale : layout vertical (espacement et marges de 10 px) qui
         empile, de haut en bas : bandeau d'information, splitter à 2 colonnes, boutons. -->
    <layout class="QVBoxLayout" name="mainVerticalLayout">
      <property name="spacing">
        <number>10</number>
      </property>
      <property name="leftMargin">
        <number>10</number>
      </property>
      <property name="topMargin">
        <number>10</number>
      </property>
      <property name="rightMargin">
        <number>10</number>
      </property>
      <property name="bottomMargin">
        <number>10</number>
      </property>

      <!-- ==========================================================================
           1. BANDEAU D'INFORMATION (labelHeaderInfo)

           Texte riche (HTML) : rappelle que la signification des champs s'affiche au
           survol du ❓ et renvoie vers la notice / le dépôt GitHub (lien externe cliquable).
           Hauteur limitée à 55 px, fond bleu clair, police 8 pt.
           ========================================================================== -->
      <item><widget class="QLabel" name="labelHeaderInfo"><property name="text"><string>Cet outil permet de faciliter la visualisation et la modification des informations foncières relatives aux sites du CEN Pays de la Loire ; la signification des champs est disponible en passant le curseur de la souris sur le ❓ à côté du nom du champ (pas besoin de cliquer dessus).&lt;br/&gt;La notice d'utilisation de l'outil est disponible dans le fichier ZIP &lt;b&gt;'plugin_sites_cen'&lt;/b&gt; ainsi qu'à l'adresse suivante : &lt;a href="https://github.com/matthieu-cen-paysdelaloire/plugin-sites-cen.git"&gt;https://github.com/matthieu-cen-paysdelaloire/plugin-sites-cen.git&lt;/a&gt;.</string></property><property name="textFormat"><enum>Qt::RichText</enum></property><property name="wordWrap"><bool>true</bool></property><property name="openExternalLinks"><bool>true</bool></property><property name="maximumHeight"><number>55</number></property><property name="styleSheet"><string>QLabel { font-weight: normal; font-size: 8pt; background-color: #eaf2f8; border: 1px solid #bdc3c7; border-radius: 6px; padding: 2px 6px; }</string></property></widget></item>
      <!-- ==========================================================================
           2. ZONE PRINCIPALE : splitter horizontal (splitter)

           Deux panneaux côte à côte dont la largeur se règle à la souris (poignée
           grise, bleue au survol) : leftContainer (2A) et rightContainer (2B).
           ========================================================================== -->
      <item>
        <widget class="QSplitter" name="splitter">
          <property name="orientation">
            <enum>Qt::Horizontal</enum>
          </property>
          
          <!-- ==========================================================================
               2A. COLONNE GAUCHE (leftContainer) : navigation et localisation

               De haut en bas : recherche + filtre, liste (sites OU parcelles),
               bouton de bascule sites/parcelles, carte de localisation.
               ========================================================================== -->
          <widget class="QWidget" name="leftContainer">
            <layout class="QVBoxLayout" name="leftSide">
              <!-- ~~~~ Recherche et filtre ~~~~
                   txtSearch : recherche texte ; cbFilterResponsable : filtre par responsable de
                   site (alimenté par le code). Tous deux appellent filter_list() dans
                   dialog_sites_mixin.py. -->
              <item>
                <layout class="QHBoxLayout" name="searchFilterLayout">
                  <item>
                    <widget class="QLineEdit" name="txtSearch">
                      <property name="placeholderText">
                        <string>Filtrer les sites...</string>
                      </property>
                    </widget>
                  </item>
                  <item>
                    <widget class="QComboBox" name="cbFilterResponsable">
                      <property name="toolTip">
                        <string>Filtrer les sites par responsable de site</string>
                      </property>
                      <property name="minimumSize">
                        <size><width>110</width><height>0</height></size>
                      </property>
                    </widget>
                  </item>
                </layout>
              </item>
              <!-- ~~~~ Liste principale : leftListStack (QStackedWidget à 2 pages, hauteur max 280 px) ~~~~
                   Page 0 = pageSites (sites), page 1 = pageParcelles (parcelles du site choisi).
                   La page affichée change avec btnToggleParcelles ; formStack (colonne droite)
                   bascule en même temps (voir dialog_parcelles_mixin.py). -->
              <item>
                <widget class="QStackedWidget" name="leftListStack">
                  <property name="minimumSize">
                    <size>
                      <width>200</width>
                      <height>0</height>
                    </size>
                  </property>
                  <property name="maximumSize">
                    <size>
                      <width>16777215</width>
                      <height>280</height>
                    </size>
                  </property>
                  <!-- Page 0 : listSites, la liste des sites (filtrée par la recherche et le
                       responsable). Sélectionner un site charge ses attributs dans le formulaire de droite. -->
                  <widget class="QWidget" name="pageSites">
                    <layout class="QVBoxLayout" name="pageSitesLayout">
                      <property name="leftMargin"><number>0</number></property>
                      <property name="topMargin"><number>0</number></property>
                      <property name="rightMargin"><number>0</number></property>
                      <property name="bottomMargin"><number>0</number></property>
                      <item>
                        <widget class="QListWidget" name="listSites" />
                      </item>
                    </layout>
                  </widget>
                  <!-- Page 1 : parcelles du site sélectionné. labelParcellesContext (titre), puis deux
                       listes côte à côte : listParcelles (N° de parcelle) et listParcellesProprietaires
                       (propriétaires de la parcelle choisie). -->
                  <widget class="QWidget" name="pageParcelles">
                    <layout class="QVBoxLayout" name="pageParcellesLayout">
                      <property name="leftMargin"><number>0</number></property>
                      <property name="topMargin"><number>0</number></property>
                      <property name="rightMargin"><number>0</number></property>
                      <property name="bottomMargin"><number>0</number></property>
                      <item>
                        <widget class="QLabel" name="labelParcellesContext">
                          <property name="text">
                            <string>Parcelles du site :</string>
                          </property>
                          <property name="wordWrap"><bool>true</bool></property>
                        </widget>
                      </item>
                      <item>
                        <layout class="QHBoxLayout" name="parcellesListsLayout">
                          <item>
                            <layout class="QVBoxLayout" name="parcellesListNumLayout">
                              <item>
                                <widget class="QLabel" name="labelParcellesListNum">
                                  <property name="text"><string>N° parcelle :</string></property>
                                </widget>
                              </item>
                              <item>
                                <widget class="QListWidget" name="listParcelles" />
                              </item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QVBoxLayout" name="parcellesListProprioLayout">
                              <item>
                                <widget class="QLabel" name="labelParcellesListProprio">
                                  <property name="text"><string>Propriétaires :</string></property>
                                </widget>
                              </item>
                              <item>
                                <widget class="QListWidget" name="listParcellesProprietaires" />
                              </item>
                            </layout>
                          </item>
                        </layout>
                      </item>
                    </layout>
                  </widget>
                </widget>
              </item>
              <!-- ~~~~ Bouton de bascule Sites / Parcelles ~~~~
                   Le texte alterne entre « Voir les parcelles du site » et « Retour aux sites ».
                   Désactivé (enabled=false) tant que la couche des parcelles n'est pas chargée ;
                   le code le réactive ensuite. Action : toggle_parcelles_view(). -->
              <item>
                <widget class="QPushButton" name="btnToggleParcelles">
                  <property name="text">
                    <string>Voir les parcelles du site</string>
                  </property>
                  <property name="enabled">
                    <bool>false</bool>
                  </property>
                </widget>
              </item>
              <!-- ~~~~ Localisation (carte) ~~~~
                   Libellé « Localisation : » puis le conteneur mapContainer. -->
              <item>
                <widget class="QLabel" name="label_map">
                  <property name="text">
                    <string>Localisation :</string>
                  </property>
                </widget>
              </item>
              <!-- mapContainer : conteneur volontairement vide (layout sans widget). Le code Python
                   y insère le canevas cartographique QGIS (QgsMapCanvas, fond OpenStreetMap) :
                   voir dialog_map_mixin.py. Taille minimale 200 x 220 px. -->
              <item>
                <widget class="QWidget" name="mapContainer" native="true">
                  <property name="minimumSize">
                    <size>
                      <width>200</width>
                      <height>220</height>
                    </size>
                  </property>
                  <layout class="QVBoxLayout" name="mapContainerLayout">
                    <property name="leftMargin"><number>0</number></property>
                    <property name="topMargin"><number>0</number></property>
                    <property name="rightMargin"><number>0</number></property>
                    <property name="bottomMargin"><number>0</number></property>
                  </layout>
                </widget>
              </item>
            </layout>
          </widget>

          <!-- ==========================================================================
               2B. COLONNE DROITE (rightContainer) : formulaire de saisie

               De haut en bas : bouton du mode édition, puis pile de formulaires (formStack).
               Au lancement, plugin_sites_cen_dialog.py place btnToggleSimpleView sur une même
               ligne que le bouton « Bilan foncier » et ajoute le lien « Comment ça marche ? » :
               ces deux éléments n'existent donc pas dans ce fichier .ui.
               ========================================================================== -->
          <widget class="QWidget" name="rightContainer">
            <layout class="QVBoxLayout" name="rightContainerLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="topMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <property name="bottomMargin"><number>0</number></property>
              <!-- Bouton à bascule « ✏️ Activer le mode édition » (checkable). Par défaut le
                   formulaire est en consultation ; l'activer déverrouille les champs ✏️ et masque
                   les champs en lecture seule. Le texte devient « Revenir à la consultation ».
                   Action : toggle_simple_view(). -->
              <item>
                <widget class="QPushButton" name="btnToggleSimpleView">
                  <property name="text"><string>✏️ Activer le mode édition</string></property>
                  <property name="checkable"><bool>true</bool></property>
                </widget>
              </item>
              <!-- ~~~~ Pile de formulaires : formStack (QStackedWidget) ~~~~
                   Index 0 = fiche du site (siteTabWidget, 4 onglets).
                   Index 1 = fiche de la parcelle (parcelleScrollArea, lecture seule).
                   Index 2 = panneau « Bilan foncier », ajouté en Python par setup_bilan_panel(). -->
              <item>
                <widget class="QStackedWidget" name="formStack">
                <!-- ~~~~ PAGE 0 : FICHE DU SITE (siteTabWidget, 4 onglets) ~~~~
                     Chaque onglet contient une QScrollArea (siteTab_N_scroll) pour défiler quand le
                     contenu dépasse. Chaque champ = deux éléments consécutifs : un QLabel (lbl_...)
                     puis son widget de saisie. -->
                <widget class="QTabWidget" name="siteTabWidget">
                  <!-- ~~~~ ONGLET 1 : « Identification du site » (siteTab_0) ~~~~
                       Nom, numéro, description ✏️, code département, ID site CEN, code comptable,
                       URL photo ✏️, URL CEN ✏️, lien vers les actes. Seuls les 3 champs ✏️ sont
                       modifiables ; les autres sont en lecture seule. -->
                  <widget class="QWidget" name="siteTab_0"><attribute name="title"><string>Identification du site</string></attribute><layout class="QVBoxLayout" name="siteTab_0_layout"><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><item><widget class="QScrollArea" name="siteTab_0_scroll"><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="siteTab_0_scrollContents"><layout class="QVBoxLayout" name="siteTab_0_innerLayout"><property name="leftMargin"><number>10</number></property><property name="topMargin"><number>10</number></property><property name="rightMargin"><number>10</number></property><item>
                          <widget class="QLabel" name="lbl_txtSite_nom_site">
                            <property name="text"><string>Nom du site : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_nom_site">
                            <property name="readOnly"><bool>true</bool></property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="lbl_txtSite_num_site">
                            <property name="text"><string>N° site : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_num_site">
                            <property name="readOnly"><bool>true</bool></property>
                          </widget>
                        </item>
                        <item>
                  <widget class="QLabel" name="label_desc">
                    <property name="text"><string>✏️ Description : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                  <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                </item><item>
                  <widget class="QTextEdit" name="txtDescription">
                    <property name="minimumSize">
                      <size><width>0</width><height>80</height></size>
                    </property>
                    <property name="placeholderText"><string>-- À renseigner --</string></property>
                  </widget>
                </item><item>
                          <widget class="QLabel" name="lbl_txtSite_code_departement">
                            <property name="text"><string>Code département : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_code_departement">
                            <property name="readOnly"><bool>true</bool></property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="lbl_txtSite_id_site_cen">
                            <property name="text"><string>ID site (CEN) : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_id_site_cen">
                            <property name="readOnly"><bool>true</bool></property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="lbl_txtSite_code_compta">
                            <property name="text"><string>Code comptable : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_code_compta">
                            <property name="readOnly"><bool>true</bool></property>
                          </widget>
                        </item>
                        <item>
                  <widget class="QLabel" name="label_url_photo">
                    <property name="text"><string>✏️ URL Photo : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                  <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                </item><item>
                  <widget class="QLineEdit" name="txtUrlPhoto">
                    <property name="placeholderText"><string>-- À renseigner --</string></property>
                  </widget>
                </item><item>
                      <widget class="QLabel" name="label_url_cen">
                        <property name="text"><string>✏️ URL CEN : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                      <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                    </item>
                    <item>
                      <widget class="QLineEdit" name="txtUrlCen">
                        <property name="placeholderText"><string>-- À renseigner --</string></property>
                      </widget>
                    </item>
                  <item>
                          <widget class="QLabel" name="lbl_txtSite_lien_vers_actes">
                            <property name="text"><string>Lien vers actes : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_lien_vers_actes">
                            <property name="readOnly"><bool>true</bool></property>
                          </widget>
                        </item>
                        <item><spacer name="siteTab_0_spacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item></layout></widget></widget></item></layout></widget>
                        <!-- ~~~~ ONGLET 2 : « Gestion et responsabilité » (siteTab_1) ~~~~
                             Champs ✏️ : responsable de site, cartographie et typologie des habitats,
                             gestionnaire. Puis groupes « Agricole » et « Évaluation du document de gestion »,
                             puis (lecture seule) document justificatif administratif, surface en libre
                             évolution ✏️ et surfaces (habitats cartographiés, SIG, sylvicole). -->
                        <widget class="QWidget" name="siteTab_1"><attribute name="title"><string>Gestion et responsabilité</string></attribute><layout class="QVBoxLayout" name="siteTab_1_layout"><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><item><widget class="QScrollArea" name="siteTab_1_scroll"><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="siteTab_1_scrollContents"><layout class="QVBoxLayout" name="siteTab_1_innerLayout"><property name="leftMargin"><number>10</number></property><property name="topMargin"><number>10</number></property><property name="rightMargin"><number>10</number></property><item>
                          <widget class="QLabel" name="lbl_txtSite_responsable_de_site">
                            <property name="text"><string>✏️ Responsable de site : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                          <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                        </item>
                        <item>
                          <widget class="QLineEdit" name="txtSite_responsable_de_site">
                            <property name="placeholderText"><string>-- À renseigner --</string></property></widget>
                        </item>
                        <item>
                            <widget class="QLabel" name="label_carto_hab">
                              <property name="text"><string>✏️ Carto. habitats : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                            <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                          </item>
                          <item>
                            <widget class="QComboBox" name="cbCartoHab" />
                          </item>
                        <item>
                            <widget class="QLabel" name="label_typo_hab">
                              <property name="text"><string>✏️ Typo. carto : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                            <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                          </item>
                          <item>
                            <widget class="QComboBox" name="cbTypoHab" />
                          </item>
                        <item>
                            <widget class="QLabel" name="label_gestionnaire">
                              <property name="text"><string>✏️ Gestionnaire : &lt;a href="?" style="text-decoration:none;"&gt;❓&lt;/a&gt;</string></property>
                            <property name="textFormat"><enum>Qt::RichText</enum></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse</set></property></widget>
                          </item>
                          <item>
                            <widget class="QLineEdit" name="txtGestionnaire">
                              <property name="placeholderText"><string>-- À renseigner --</string></property>
                            </widget>
                          </item>
                          <!-- Groupe « Agricole » : nombre de contrats, nombre d'agriculteurs, surface sous
                               contrat (3 champs numériques, tous modifiables ✏️). -->
                          <item>
                            <widget class="QGroupBox" name="groupAgricole">
                              <property name="title"><string>Agricole</string></property>
                              <layout class="QVBoxLayout" name="groupAgricole_layout">
