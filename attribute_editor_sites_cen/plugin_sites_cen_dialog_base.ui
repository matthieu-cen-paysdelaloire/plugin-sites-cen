                              <property name="orientation"><enum>Qt::Horizontal</enum></property>
                              <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                            </spacer>
                          </item>
                        </layout>
                      </item>
                      <item>
                        <widget class="QComboBox" name="cbGeolStep1" />
                      </item>
                      <item>
                        <widget class="QLabel" name="lblGeol2">
                          <property name="text"><string>2nde branche :</string></property>
                        </widget>
                      </item>
