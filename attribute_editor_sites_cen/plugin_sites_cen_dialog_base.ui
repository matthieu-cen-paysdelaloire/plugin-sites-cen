                        </widget>
                      </item>
                      <item>
                        <widget class="QComboBox" name="cbGeolStep3" />
                      </item>
                      <item>
                        <widget class="QLabel" name="lblGeol4">
                          <property name="text"><string>4ème branche :</string></property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QComboBox" name="cbGeolStep4" />
                      </item>
                      <item>
                        <widget class="QLabel" name="lblGeolFinal">
                          <property name="text"><string>Code final :</string></property>
                          <property name="visible"><bool>false</bool></property>
                        </widget>
                      </item>
                      <item>
                        <widget class="QLineEdit" name="txtGeolResult">
                          <property name="readOnly"><bool>true</bool></property>
                          <property name="visible"><bool>false</bool></property>
                        </widget>
                      </item>
                    </layout>
                  </widget>
                </item>
                <!-- Groupe « Caractère sensible du site » : ouverture au public ✏️, sensibilité ✏️,
                     non-diffusion ✏️, remarque sur la sensibilité ✏️ (zone de texte), puis ENS,
                     site classé et site CEN communicable (lecture seule). -->
                <item>
                          <widget class="QGroupBox" name="groupSensibilite">
                            <property name="title"><string>Caractère sensible du site</string></property>
