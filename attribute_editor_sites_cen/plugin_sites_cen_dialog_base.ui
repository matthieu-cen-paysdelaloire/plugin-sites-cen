                        <!-- Groupe « ✏️ Code Géologique » : 4 listes déroulantes en cascade (cbGeolStep1 à
                             cbGeolStep4) ; le choix d'une branche alimente la suivante (update_geol_cascade,
                             dialog_geology_mixin.py ; arbre DICT_GEOL_STEP dans dialog_data.py). « Code final »
                             (txtGeolResult) est calculé automatiquement, donc toujours en lecture seule.
                             Le ❓ (lblGeol1Help) utilise une infobulle Qt native (setToolTip), contrairement
                             aux autres champs qui passent par le survol du lien HTML. -->
                        <item>
                  <widget class="QGroupBox" name="groupGeolDecision">
                    <property name="title">
                      <string>✏️ Code Géologique :</string>
                    </property>
                    <layout class="QVBoxLayout">
                      <item>
